{
  "name": "adu-ai",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rm -Rf release-builds",
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "pack-linux": "electron-builder --linux",
    "pack-win": "electron-builder --win=portable",
    "pack-mac": "electron-builder --mac --arm64 --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ai",
    "desktop"
  ],
  "author": "ADU AI",
  "license": "BSD-3-Clause",
  "description": "ADU AI desktop client",
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1"
  },
  "overrides": {
    "debug": "4.3.7"
  },
  "build": {
    "appId": "com.aduai.app",
    "productName": "ADU AI",
    "directories": {
      "output": "/tmp/adu-ai-builds"
    },
    "afterPack": "scripts/after-pack.js",
    "linux": {
      "target": "AppImage",
      "icon": "./img/icon.png",
      "category": "Office"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "./img/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "./img/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
