    <name>ADU AI</name>
    <summary>Desktop client for Perplexity.AI and Claude.AI</summary>
    <developer id="com.aduai">
        <name>ADU AI</name>
    </developer>
    <description>
        <p>Desktop client for Perplexity.AI and Claude.AI with a built-in Clash-style proxy (mihomo core). The proxy is scoped to this application only — it never touches system proxy settings.</p>
        <ul>
            <li>Switch between Perplexity.AI and Claude.AI from the menu</li>
            <li>Per-app Clash subscription support</li>
            <li>Persistent window state and login session</li>
        </ul>
    </description>
    <launchable type="desktop-id">com.aduai.app.desktop</launchable>
