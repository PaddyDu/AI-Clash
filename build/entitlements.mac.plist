<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow Electron's V8 JIT under hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required so child processes (Helper, Renderer, GPU) can load Electron's
         own dylibs that aren't signed by your Developer ID -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network out-bound for the proxy / web content -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Inbound listener so mihomo's local mixed-port can be reached by
         our own Electron session -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Spawning mihomo as a child process -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
